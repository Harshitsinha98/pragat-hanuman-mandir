# ---- Server ----
PORT=5002

# ---- Razorpay (https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---- Resend email (https://resend.com/api-keys) ----
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=श्री प्रगट हनुमान जी देवस्थानम <onboarding@resend.dev>
ADMIN_ALERT_EMAIL=you@example.com

# ---- Admin dashboard ----
ADMIN_PASSWORD=choose_a_strong_password

# ---- CORS ----
# Comma-separated allowed origins. Leave blank to allow all (development only).
ALLOWED_ORIGINS=https://your-frontend-domain.com
